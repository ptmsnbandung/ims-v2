# Disable script execution inside uploads directory
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phar|inc|pl|py|cgi|sh|bash|exe|bat|cmd)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Disable PHP engine if mod_php is active
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Prevent directory indexing and script execution
Options -Indexes -ExecCGI
