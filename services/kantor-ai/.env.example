# =========================================================================
# KANTOR AI (n8n + PostgreSQL + Cloudflare Tunnel) - ENVIRONMENT CONFIG
# =========================================================================

# Database Internal n8n (PostgreSQL)
POSTGRES_USER=n8n_admin
POSTGRES_PASSWORD=ganti_dengan_password_db_n8n_yang_sangat_kuat_123!
POSTGRES_DB=n8n_ims

# Port lokal n8n di server host
N8N_PORT=5678

# Enkripsi Credential n8n (Wajib dibuat string acak minimal 32 karakter)
# Contoh generate di bash: openssl rand -hex 16
N8N_ENCRYPTION_KEY=ganti_dengan_random_key_minimal_32_karakter_unik

# Host dan Domain Webhook
# Jika menggunakan Cloudflare Tunnel: isi dengan subdomain yang diarahkan ke http://n8n:5678
N8N_HOST=ai-office.ptmsn.net
N8N_PROTOCOL=https
WEBHOOK_URL=https://ai-office.ptmsn.net/

# Cloudflare Tunnel Token
# Dapatkan dari Cloudflare Zero Trust Dashboard -> Networks -> Tunnels
# Lalu arahkan Service HTTP ke: http://n8n:5678
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiZXhhbXBsZXRva2VuMSIsInQiOiJleGFtcGxlLXRva2VuLTIiLCJzIjoiZXhhbXBsZXRva2VuMyJ9

# Koneksi Database MySQL IMS Host (Untuk referensi input credential di n8n)
IMS_MYSQL_HOST=host.docker.internal
IMS_MYSQL_PORT=3306
IMS_MYSQL_DATABASE=ims_v2
IMS_MYSQL_USER=n8n_reader
IMS_MYSQL_PASSWORD=password_khusus_n8n_reader
